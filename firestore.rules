rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'vanloiphuhiep.09@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'role',
          'credits',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'photoURL',
          'role',
          'credits',
          'usedCredits',
          'lastFreeResetAt',
          'lastRedeemedCode',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 200 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('lastFreeResetAt' in data) || data.lastFreeResetAt is timestamp) &&
        (!('lastRedeemedCode' in data) || (data.lastRedeemedCode is string && data.lastRedeemedCode.size() <= 64)) &&
        data.role is string && data.role in ['teacher', 'admin'] &&
        data.credits is int && data.credits >= 0 && data.credits <= 1000000 &&
        (!('usedCredits' in data) || (data.usedCredits is int && data.usedCredits >= 0 && data.usedCredits <= 100000000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContentItem(data) {
      return data.keys().hasAll([
          'id',
          'zone',
          'title',
          'type',
          'order',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'zone',
          'title',
          'description',
          'type',
          'order',
          'embedCode',
          'embedChunkCount',
          'instructions',
          'grade',
          'subject',
          'creditCost',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.zone is string && data.zone in ['virtual_spaces', 'apps', 'games', 'simulations', 'management', 'guides'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        data.type is string && data.type in ['virtual_space', 'app', 'game', 'simulation', 'management', 'guide'] &&
        data.order is int && data.order >= 0 && data.order <= 100000 &&
        (!('embedCode' in data) || (data.embedCode is string && data.embedCode.size() <= 750000)) &&
        (!('embedChunkCount' in data) || (data.embedChunkCount is int && data.embedChunkCount >= 0 && data.embedChunkCount <= 30)) &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 5000)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 40)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 60)) &&
        (!('creditCost' in data) || (data.creditCost is int && data.creditCost >= 0 && data.creditCost <= 100000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEmbedChunk(data) {
      return data.keys().hasAll(['index', 'data', 'updatedAt']) &&
        data.keys().hasOnly(['index', 'data', 'updatedAt']) &&
        data.index is int && data.index >= 0 && data.index < 30 &&
        data.data is string && data.data.size() > 0 && data.data.size() <= 450000 &&
        data.updatedAt is timestamp;
    }

    function isValidBrandingSetting(data) {
      return data.keys().hasAll(['updatedAt']) &&
        data.keys().hasOnly(['homeAvatar', 'virtualSpacesAvatar', 'appsAvatar', 'gamesAvatar', 'simsAvatar', 'managementAvatar', 'guidesAvatar', 'updatedAt']) &&
        (!('homeAvatar' in data) || (data.homeAvatar is string && data.homeAvatar.size() <= 500000)) &&
        (!('virtualSpacesAvatar' in data) || (data.virtualSpacesAvatar is string && data.virtualSpacesAvatar.size() <= 500000)) &&
        (!('appsAvatar' in data) || (data.appsAvatar is string && data.appsAvatar.size() <= 500000)) &&
        (!('gamesAvatar' in data) || (data.gamesAvatar is string && data.gamesAvatar.size() <= 500000)) &&
        (!('simsAvatar' in data) || (data.simsAvatar is string && data.simsAvatar.size() <= 500000)) &&
        (!('managementAvatar' in data) || (data.managementAvatar is string && data.managementAvatar.size() <= 500000)) &&
        (!('guidesAvatar' in data) || (data.guidesAvatar is string && data.guidesAvatar.size() <= 500000)) &&
        data.updatedAt is timestamp;
    }

    function isValidCatalogSetting(data) {
      return data.keys().hasAll(['initialized', 'updatedAt']) &&
        data.keys().hasOnly(['initialized', 'updatedAt']) &&
        data.initialized is bool &&
        data.updatedAt is timestamp;
    }

    function isValidTeacherAppData(data) {
      return data.keys().hasAll(['entries', 'updatedAt']) &&
        data.keys().hasOnly(['entries', 'updatedAt']) &&
        data.entries is map &&
        data.entries.size() <= 500 &&
        data.updatedAt is timestamp;
    }

    // --- Collection: /admins/{adminUid} ---
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isBootstrappedAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().role == 'teacher' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().email.lower() == request.auth.token.email.lower() &&
            incoming().credits == 20 &&
            (!('usedCredits' in incoming()) || incoming().usedCredits == 0) &&
            (!('lastFreeResetAt' in incoming()) || incoming().lastFreeResetAt == request.time) &&
            !('lastRedeemedCode' in incoming())
          ) ||
          (
            isAdmin() &&
            incoming().credits >= 0 &&
            (!('usedCredits' in incoming()) || incoming().usedCredits >= 0) &&
            (!('lastFreeResetAt' in incoming()) || incoming().lastFreeResetAt is timestamp)
          )
        );

      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Admin top-up, credit adjustment, or seed sync
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'usedCredits', 'lastFreeResetAt', 'fullName', 'photoURL', 'updatedAt'])
          ) ||
          // Action 2: Owner syncs display name / photo on login
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'photoURL', 'updatedAt'])
          ) ||
          // Action 3: Owner consumes AI credits (4 for standard zones, or custom creditCost >= 1 for Ứng dụng Tiện ích; must increment usedCredits by exact spent delta, optionally after a 24h reset)
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'usedCredits', 'lastFreeResetAt', 'updatedAt']) &&
            incoming().credits >= 0 &&
            ('usedCredits' in incoming()) &&
            (
              (
                !('lastFreeResetAt' in incoming().diff(existing()).affectedKeys()) &&
                (existing().credits - incoming().credits) >= 1 &&
                (existing().credits - incoming().credits) <= 100000 &&
                incoming().usedCredits == ((('usedCredits' in existing()) ? existing().usedCredits : 0) + (existing().credits - incoming().credits))
              ) ||
              (
                ('lastFreeResetAt' in incoming()) &&
                incoming().lastFreeResetAt == request.time &&
                existing().credits < 20 &&
                request.time >= (('lastFreeResetAt' in existing()) ? existing().lastFreeResetAt : existing().createdAt) + duration.value(24, 'h') &&
                (20 - incoming().credits) >= 1 &&
                (20 - incoming().credits) <= 100000 &&
                incoming().usedCredits == ((('usedCredits' in existing()) ? existing().usedCredits : 0) + (20 - incoming().credits))
              )
            )
          ) ||
          // Action 4: 24-hour automatic daily free credit reset (refresh to 20 credits if < 20 and >= 24h since lastFreeResetAt)
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'lastFreeResetAt', 'updatedAt']) &&
            existing().credits < 20 &&
            incoming().credits == 20 &&
            ('lastFreeResetAt' in incoming()) &&
            incoming().lastFreeResetAt == request.time &&
            request.time >= (('lastFreeResetAt' in existing()) ? existing().lastFreeResetAt : existing().createdAt) + duration.value(24, 'h')
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /app_data/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(itemId) && isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidTeacherAppData(incoming()) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(itemId) && isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidTeacherAppData(incoming()) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // --- Collection: /admin_app_data/{itemId} ---
    match /admin_app_data/{itemId} {
      allow get: if isValidId(itemId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(itemId) && isAdmin() &&
        isValidTeacherAppData(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isAdmin() &&
        isValidTeacherAppData(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'updatedAt']);
      allow delete: if isValidId(itemId) && isAdmin();
    }


    // --- Collection: /content_items/{itemId} (Public educational catalog, Admin-managed) ---
    match /content_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.zone in ['virtual_spaces', 'apps', 'games', 'simulations', 'management', 'guides'];

      allow create: if isValidId(itemId) &&
        isAdmin() &&
        isValidContentItem(incoming()) &&
        incoming().id == itemId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(itemId) &&
        isAdmin() &&
        isValidContentItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'zone',
          'title',
          'description',
          'type',
          'order',
          'embedCode',
          'embedChunkCount',
          'instructions',
          'grade',
          'subject',
          'creditCost',
          'updatedAt'
        ]);

      allow delete: if isValidId(itemId) && isAdmin();

      match /embed_chunks/{chunkId} {
        allow get: if isValidId(itemId) && isValidId(chunkId);
        allow list: if isValidId(itemId) && resource.data.index is int && resource.data.index >= 0;

        allow create: if isValidId(itemId) &&
          isValidId(chunkId) &&
          isAdmin() &&
          isValidEmbedChunk(incoming()) &&
          incoming().updatedAt == request.time &&
          (
            exists(/databases/$(database)/documents/content_items/$(itemId)) ||
            existsAfter(/databases/$(database)/documents/content_items/$(itemId))
          );

        allow update: if isValidId(itemId) &&
          isValidId(chunkId) &&
          isAdmin() &&
          isValidEmbedChunk(incoming()) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['index', 'data', 'updatedAt']) &&
          exists(/databases/$(database)/documents/content_items/$(itemId));

        allow delete: if isValidId(itemId) && isValidId(chunkId) && isAdmin();
      }
    }

    // --- Collection: /site_settings/{settingId} (Branding, catalog & accounts initialization state) ---
    match /site_settings/{settingId} {
      allow get: if settingId in ['branding', 'catalog', 'accounts'];
      allow list: if false;

      allow create: if isAdmin() && (
        (
          settingId == 'branding' &&
          isValidBrandingSetting(incoming()) &&
          incoming().updatedAt == request.time
        ) ||
        (
          settingId in ['catalog', 'accounts'] &&
          isValidCatalogSetting(incoming()) &&
          incoming().updatedAt == request.time
        )
      );

      allow update: if isAdmin() && (
        (
          settingId == 'branding' &&
          isValidBrandingSetting(incoming()) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'homeAvatar',
            'virtualSpacesAvatar',
            'appsAvatar',
            'gamesAvatar',
            'simsAvatar',
            'managementAvatar',
            'guidesAvatar',
            'updatedAt'
          ])
        ) ||
        (
          settingId in ['catalog', 'accounts'] &&
          isValidCatalogSetting(incoming()) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['initialized', 'updatedAt'])
        )
      );

      allow delete: if isAdmin() && settingId in ['branding', 'catalog', 'accounts'];
    }
  }
}
